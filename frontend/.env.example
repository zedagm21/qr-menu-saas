# Environment variables for the frontend

# Backend API server URL
# By default (in development without this variable), Vite will proxy /api to localhost:3001.
# LOCAL DEVELOPMENT (LAN testing): http://YOUR_PC_IP:3001
# PRODUCTION: https://api.yourdomain.com
VITE_API_URL=http://192.168.40.4:3001

# Google OAuth 2.0 Client ID (matches GOOGLE_CLIENT_ID in backend)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

