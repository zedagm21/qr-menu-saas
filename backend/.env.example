# Environment variables for the backend
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/qrmenu_db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your-cookie-secret-change-in-production

# Frontend URL (for CORS)
# LOCAL DEVELOPMENT: http://localhost:5173 or http://YOUR_PC_IP:5173 for LAN testing
FRONTEND_URL=http://192.168.40.3:5173

# Image Storage (Local fallback)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Cloudflare R2 Object Storage Configuration (Phase 2)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=qr-menu-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# App URL (used for QR code URLs)
# LOCAL DEVELOPMENT: http://localhost:5173 or http://YOUR_PC_IP:5173 for LAN testing
# PRODUCTION: https://yourdomain.com
APP_URL=http://192.168.40.3:5173

# Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Brevo (Sendinblue) Email Configuration ───
# Sign up at https://brevo.com → SMTP & API → API Keys → Create key
# Verify your sender email at: Senders & IPs → Senders
# In development, if BREVO_API_KEY is empty, OTP codes are printed to the terminal automatically.
BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM=your-verified-email@gmail.com