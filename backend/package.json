    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.19.1",
