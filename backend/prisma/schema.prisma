// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
}

enum Language {
  EN
  AM
}

enum MenuStatus {
  DRAFT
  PUBLISHED
}

enum MenuStyle {
  CLASSIC
  MODERN
  ELEGANT
  MINIMAL
}

enum ThemeMode {
  LIGHT
  DARK
  AUTO
}

enum InteractionType {
  PROFILE_VIEW
  SOCIAL_CLICK
  CALL_CLICK
  DIRECTIONS_CLICK
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                       String      @id @default(cuid())
  name                     String
  email                    String      @unique
  passwordHash             String?
  googleId                 String?     @unique
  emailVerified            Boolean     @default(false)
  emailVerificationOtp     String?
  emailVerificationExpires DateTime?
  resendAttemptsCount      Int         @default(0)
  lastResendAttemptAt      DateTime?
  role                     Role        @default(OWNER)
  restaurantId             String?
  restaurant               Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  auditLogs                AuditLog[]
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@map("users")
}

model Restaurant {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  description         String?
  logoUrl             String?
  coverImageUrl       String?
  phone               String?
  email               String?
  address             String?
  city                String?
  country             String               @default("Ethiopia")
  defaultLanguage     Language             @default(EN)
  currency            String               @default("ETB")
  status              MenuStatus           @default(DRAFT)
  isSuspended         Boolean              @default(false)
  suspensionReason    String?
  wifiName            String?
  wifiPassword        String?
  paymentInfo         String?
  socialMedia         Json?
  users               User[]
  translations        RestaurantTranslation[]
  categories          Category[]
  menuItems           MenuItem[]
  qrCodes             QRCode[]
  theme               RestaurantTheme?
  scanEvents          ScanEvent[]
  menuItemClicks      MenuItemClick[]
  searchQueries       SearchQueryLog[]
  profileInteractions ProfileInteraction[]
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("restaurants")
}

model RestaurantTranslation {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  language     Language
  name         String
  description  String?
  address      String?
  city         String?

  @@unique([restaurantId, language])
  @@map("restaurant_translations")
}

model Category {
  id           String                @id @default(cuid())
  restaurantId String
  restaurant   Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  displayOrder Int                   @default(0)
  isActive     Boolean               @default(true)
  translations CategoryTranslation[]
  menuItems    MenuItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([restaurantId, isActive, displayOrder])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language    Language
  name        String
  description String?

  @@unique([categoryId, language])
  @@map("category_translations")
}

model MenuItem {
  id            String                @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price         Decimal               @db.Decimal(10, 2)
  discountPrice Decimal?              @db.Decimal(10, 2)
  currency      String                @default("ETB")
  imageUrl      String?
  isAvailable   Boolean               @default(true)
  displayOrder  Int                   @default(0)
  isFeatured    Boolean               @default(false)
  isSpicy       Boolean               @default(false)
  translations  MenuItemTranslation[]
  clicks        MenuItemClick[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([restaurantId, displayOrder])
  @@index([categoryId, displayOrder])
  @@index([restaurantId, isAvailable, displayOrder])
  @@map("menu_items")
}

model MenuItemTranslation {
  id          String   @id @default(cuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  language    Language
  name        String
  description String?
  ingredients String?
  allergens   String?

  @@unique([menuItemId, language])
  @@map("menu_item_translations")
}

model QRCode {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String      @default("Main QR")
  isActive     Boolean     @default(true)
  scans        ScanEvent[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([restaurantId])
  @@map("qr_codes")
}

model RestaurantTheme {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  primaryColor String     @default("#D97706")
  accentColor  String     @default("#F59E0B")
  fontFamily   String     @default("Inter")
  menuStyle    MenuStyle  @default(CLASSIC)
  darkMode     ThemeMode  @default(AUTO)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("restaurant_themes")
}

// ─── QR Scan Tracking Event ──────────────────────────────────────────────────
model ScanEvent {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrCodeId     String?
  qrCode       QRCode?     @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  tableNumber  String?
  device       String?     // 'Mobile', 'Tablet', 'Desktop'
  os           String?     // 'iOS', 'Android', 'Other'
  language     Language?
  ipHash       String?     // SHA-256 hashed identifier for unique diner deduplication
  createdAt    DateTime    @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, qrCodeId])
  @@map("scan_events")
}

// ─── Menu Item Interaction Event ─────────────────────────────────────────────
model MenuItemClick {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([restaurantId, createdAt])
  @@index([menuItemId, createdAt])
  @@map("menu_item_clicks")
}

// ─── Customer Search Query Demand Log ────────────────────────────────────────
model SearchQueryLog {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  query        String
  resultsCount Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([restaurantId, createdAt])
  @@map("search_query_logs")
}

// ─── Restaurant Profile & Social Media Interaction ───────────────────────────
model ProfileInteraction {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type         InteractionType
  platform     String?         // 'instagram', 'telegram', 'tiktok', 'facebook', 'phone', 'directions'
  createdAt    DateTime        @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, type])
  @@map("profile_interactions")
}

// ─── Platform Audit Log ──────────────────────────────────────────────────────
model AuditLog {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  action       String
  details      Json?
  ipAddress    String?
  createdAt    DateTime    @default(now())

  @@index([createdAt])
  @@index([restaurantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
